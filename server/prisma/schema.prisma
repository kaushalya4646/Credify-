// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  candidateProfile CandidateProfile?
  recruiterProfile RecruiterProfile?
  attempts            AssessmentAttempt[]
  skillVerifications  SkillVerification[]
  postedJobs          Job[]
  applications        Application[]
  savedCandidates     SavedCandidate[] @relation("RecruiterSaves")
  savedByRecruiters   SavedCandidate[] @relation("CandidateSaves")
}
  
model CandidateProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  bio        String?
  education  String?
  links      String?
  visibility String   @default("public")
  createdAt  DateTime @default(now())
  targetCareerRoleId String?
  targetCareerRole   CareerRole? @relation(fields: [targetCareerRoleId], references: [id])
  experienceYears    Int?
  careerInterests    String?
  technicalSkills    String? // comma-separated plain text, self-reported, NOT verified
  projects           Project[]
  certifications     Certification[]
}

model Project {
  id                 String           @id @default(uuid())
  name               String
  link               String?
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
}

model Certification {
  id                 String           @id @default(uuid())
  name               String
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
}

model RecruiterProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  companyName    String?
  companyWebsite String?
  createdAt      DateTime @default(now())
}

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String?
  type      String?
  status    String   @default("Active")
  createdAt DateTime @default(now())
  careerRoles CareerRoleSkill[]
  assessments Assessment[]
  skillVerifications SkillVerification[]
  jobSkills JobSkill[]
}

model CareerRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  category    String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  skills     CareerRoleSkill[]
  candidates CandidateProfile[]
}

model CareerRoleSkill {
  id            String     @id @default(uuid())
  careerRoleId  String
  careerRole    CareerRole @relation(fields: [careerRoleId], references: [id])
  skillId       String
  skill         Skill      @relation(fields: [skillId], references: [id])
  requiredLevel String

  @@unique([careerRoleId, skillId])
}

model Assessment {
  id              String   @id @default(uuid())
  skillId         String
  skill           Skill    @relation(fields: [skillId], references: [id])
  title           String
  description     String?
  difficulty      String
  type            String
  durationMinutes Int?
  status          String   @default("Active")
  passingScore    Int      @default(70)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  questions       AssessmentQuestion[]
  attempts        AssessmentAttempt[]
}

model AssessmentQuestion {
  id             String     @id @default(uuid())
  assessmentId   String
  assessment     Assessment @relation(fields: [assessmentId], references: [id])
  questionText   String
  type           String     @default("MCQ") // "MCQ" | "Short answer" | "Long answer"
  options        Json?      // MCQ only: array of option text strings
  correctAnswer  String?    // MCQ only: must equal one of the options
  position       Int        @default(0) // display order within the assessment
  answers        AttemptAnswer[]
}

// One row per question a candidate answered in an attempt.
model AttemptAnswer {
  id         String             @id @default(uuid())
  attemptId  String
  attempt    AssessmentAttempt  @relation(fields: [attemptId], references: [id])
  questionId String
  question   AssessmentQuestion @relation(fields: [questionId], references: [id])
  answer     String
  isCorrect  Boolean? // null for Short/Long answer (not auto-graded)

  @@unique([attemptId, questionId])
}

model AssessmentAttempt {
  id               String     @id @default(uuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id])
  assessmentId     String
  assessment       Assessment @relation(fields: [assessmentId], references: [id])
  score            Int?
  correctCount     Int?
  totalQuestions   Int?
  timeTakenSeconds Int?
  status           String     @default("In Progress")
  completedAt      DateTime?
  createdAt        DateTime   @default(now())
  answers          AttemptAnswer[]
}

model SkillVerification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id])
  status     String   @default("Not Verified")
  verifiedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([userId, skillId])
}

// Platform-wide settings: a single row with id "singleton".
model Settings {
  id                           String   @id @default("singleton")
  platformName                 String   @default("Credify")
  platformDescription          String?
  defaultLanguage              String   @default("en-US")
  allowRegistration            Boolean  @default(true)
  requireEmailVerification     Boolean  @default(true)
  allowRecruiterRegistration   Boolean  @default(true)
  maxAssessmentDurationMinutes Int      @default(180)
  maxAttempts                  Int      @default(3)
  defaultPassingScore          Int      @default(50)
  randomizeQuestions           Boolean  @default(false)
  verificationExpiryDays       Int?
  verificationBadgeMode        String   @default("Allowed")
  minScoreForVerification      Int      @default(50)
  recruiterAccessControl       String   @default("All candidates")
  sessionTimeoutMinutes        Int      @default(1440)
  dataRetentionDays            Int?
  skillRecommendations         Boolean  @default(true)
  careerRecommendations        Boolean  @default(true)
  candidateMatching            Boolean  @default(true)
  platformDisabled             Boolean  @default(false)
  updatedAt                    DateTime @default(now()) @updatedAt
}

// A job posted by a recruiter.
model Job {
  id                 String        @id @default(uuid())
  recruiterId        String
  recruiter          User          @relation(fields: [recruiterId], references: [id])
  title              String
  description        String
  employmentType     String        // "full-time" | "part-time"
  country            String
  city               String
  experienceRequired String?       // e.g. "2 years"
  degree             String?
  university         String?
  currency           String        @default("LKR")
  salaryLow          Int
  salaryHigh         Int
  deadline           DateTime
  status             String        @default("Draft") // "Draft" | "Active" | "Closed"
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now()) @updatedAt
  jobSkills          JobSkill[]
  applications       Application[]
}

model JobSkill {
  id      String @id @default(uuid())
  jobId   String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id])
  level   String // "required" | "preferred" | "optional"

  @@unique([jobId, skillId])
}

model Application {
  id              String   @id @default(uuid())
  jobId           String
  job             Job      @relation(fields: [jobId], references: [id])
  candidateUserId String
  candidate       User     @relation(fields: [candidateUserId], references: [id])
  status          String   @default("Applied") // "Applied" | "Withdrawn"
  appliedAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([jobId, candidateUserId])
}

// A candidate bookmarked by a recruiter. Only a bookmark, so it goes with
// either account if that account is deleted.
model SavedCandidate {
  id              String    @id @default(uuid())
  recruiterId     String
  recruiter       User      @relation("RecruiterSaves", fields: [recruiterId], references: [id], onDelete: Cascade)
  candidateUserId String
  candidate       User      @relation("CandidateSaves", fields: [candidateUserId], references: [id], onDelete: Cascade)
  savedAt         DateTime  @default(now())
  contactedAt     DateTime?

  @@unique([recruiterId, candidateUserId])
}
