{
  "info": {
    "name": "Credify API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "adminToken", "value": "" },
    { "key": "candidateToken", "value": "" },
    { "key": "recruiterToken", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@test.com\", \"password\": \"test1234\", \"name\": \"Admin Test\", \"role\": \"ADMIN\"}"
            }
          }
        },
        {
          "name": "Register Candidate",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"candidate@test.com\", \"password\": \"test1234\", \"name\": \"Candidate Test\", \"role\": \"CANDIDATE\"}"
            }
          }
        },
        {
          "name": "Register Recruiter",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"recruiter@test.com\", \"password\": \"test1234\", \"name\": \"Recruiter Test\", \"role\": \"RECRUITER\"}"
            }
          }
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the token so requests using {{adminToken}} work without copy-pasting.",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set(\"adminToken\", pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@test.com\", \"password\": \"test1234\"}"
            }
          }
        },
        {
          "name": "Login Candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the token so requests using {{candidateToken}} work without copy-pasting.",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set(\"candidateToken\", pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"candidate@test.com\", \"password\": \"test1234\"}"
            }
          }
        },
        {
          "name": "Login Recruiter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the token so requests using {{recruiterToken}} work without copy-pasting.",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set(\"recruiterToken\", pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"recruiter@test.com\", \"password\": \"test1234\"}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] }
          }
        }
      ]
    },
    {
      "name": "Skills",
      "item": [
        {
          "name": "List Skills",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/skills",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] }
          }
        },
        {
          "name": "List Skills (candidate — Active only)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/skills",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{candidateToken}}" }] },
            "description": "Non-admins only see skills with status \"Active\". Each skill includes usage = number of users who have it Verified."
          }
        },
        {
          "name": "Create Skill (admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/skills",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Node.js\", \"category\": \"Backend\", \"type\": \"Technical skill\", \"status\": \"Active\"}"
            }
          }
        },
        {
          "name": "Update Skill (admin)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/skills/REPLACE_SKILL_ID",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Node.js\", \"category\": \"Backend Development\", \"type\": \"Technical skill\", \"status\": \"Inactive\"}"
            }
          }
        },
        {
          "name": "Delete Skill (admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/skills/REPLACE_SKILL_ID",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] }
          }
        }
      ]
    },
    {
      "name": "Skill Categories",
      "item": [
        {
          "name": "Create Skill Category (admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/skills/categories",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"category\": \"Cloud\", \"type\": \"Tool/platform\", \"status\": \"Active\", \"skillNames\": [\"AWS\", \"Azure\", \"GCP\"]}"
            },
            "description": "Warning: if skills named AWS, Azure or GCP already exist, running this moves them into the \"Cloud\" category.\n\nCreates each listed skill, or moves an existing skill with that name into this category."
          }
        },
        {
          "name": "Update Skill Category (admin)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/skills/categories/Cloud",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"newCategoryName\": \"Cloud Platforms\", \"type\": \"Tool/platform\", \"status\": \"Active\", \"skillNames\": [\"AWS\", \"GCP\", \"Terraform\"]}"
            },
            "description": "Warning: if skills named AWS, GCP or Terraform already exist elsewhere, running this moves them into \"Cloud Platforms\".\n\nURL param is the current category name (URL-encode spaces). Skills dropped from skillNames are unassigned (category: null), never deleted. type/status default to null/\"Active\" if omitted."
          }
        },
        {
          "name": "Delete Skill Category (admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/skills/categories/Cloud%20Platforms",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "description": "All or nothing: returns 409 listing the skills that are in use (career roles, assessments or verifications) and deletes nothing."
          }
        }
      ]
    },
    {
      "name": "Career Roles",
      "item": [
        {
          "name": "List Career Roles",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/career-roles",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] }
          }
        },
        {
          "name": "List Career Roles (candidate — Active only)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/career-roles",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{candidateToken}}" }] },
            "description": "Non-admins only see Active career roles."
          }
        },
        {
          "name": "Get Career Role by Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/career-roles/REPLACE_ROLE_ID",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{candidateToken}}" }] }
          }
        },
        {
          "name": "Get My Selected Career Role (candidate)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/career-roles/me/selected",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{candidateToken}}" }] },
            "description": "Returns null if the candidate hasn't selected a role."
          }
        },
        {
          "name": "Select Career Role (candidate)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/career-roles/me/select",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{candidateToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"careerRoleId\": \"REPLACE_ROLE_ID\"}"
            }
          }
        },
        {
          "name": "Create Career Role (admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/career-roles",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Backend Developer\", \"description\": \"Builds server-side systems\", \"category\": \"Engineering\", \"status\": \"Active\", \"skillNames\": [\"Node.js\", \"SQL\"]}"
            }
          }
        },
        {
          "name": "Attach Skill to Career Role (admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/career-roles/REPLACE_ROLE_ID/skills",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"skillId\": \"REPLACE_SKILL_ID\", \"requiredLevel\": \"Intermediate\"}"
            }
          }
        },
        {
          "name": "Update Career Role (admin)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/career-roles/REPLACE_ROLE_ID",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Backend Developer\", \"description\": \"Updated description\", \"category\": \"Engineering\", \"status\": \"Active\", \"skillNames\": [\"Node.js\", \"SQL\", \"React\"]}"
            }
          }
        },
        {
          "name": "Delete Career Role (admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/career-roles/REPLACE_ROLE_ID",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] }
          }
        }
      ]
    },
    {
      "name": "Assessments",
      "item": [
        {
          "name": "Assessments",
          "item": [
            {
              "name": "List Assessments",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/assessments",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] }
              }
            },
            {
              "name": "List Assessments (candidate — Active only)",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/assessments",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{candidateToken}}" }] },
                "description": "Non-admins only see Active assessments. The admin version also returns attemptsCount and avgScore (null when nobody has completed it)."
              }
            },
            {
              "name": "Get Assessment by Id",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/assessments/REPLACE_ASSESSMENT_ID",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{candidateToken}}" }] }
              }
            },
            {
              "name": "Get Assessment by Id (admin — includes answers)",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/assessments/REPLACE_ASSESSMENT_ID",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
                "description": "Same endpoint as above; admins also get each question's correctAnswer."
              }
            },
            {
              "name": "Create Assessment (admin)",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/assessments",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\"skillId\": \"REPLACE_SKILL_ID\", \"title\": \"Node.js Basics\", \"description\": \"Core Node.js concepts.\", \"difficulty\": \"Beginner\", \"type\": \"Multiple Choice\", \"durationMinutes\": 15, \"passingScore\": 70}"
                },
                "description": "New assessments are created as Draft (pass status to override). passingScore defaults to 70."
              }
            },
            {
              "name": "Update Assessment (admin)",
              "request": {
                "method": "PUT",
                "url": "{{baseUrl}}/api/assessments/REPLACE_ASSESSMENT_ID",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\"status\": \"Active\", \"passingScore\": 60}"
                },
                "description": "Only the fields sent are changed. Accepts title, description, skillId, difficulty, type, durationMinutes, passingScore, status (Active | Draft | Inactive)."
              }
            },
            {
              "name": "Duplicate Assessment (admin)",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/assessments/REPLACE_ASSESSMENT_ID/duplicate",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
                "description": "Copies the assessment and its questions as a Draft titled \"… (copy)\"."
              }
            },
            {
              "name": "Delete Assessment (admin)",
              "request": {
                "method": "DELETE",
                "url": "{{baseUrl}}/api/assessments/REPLACE_ASSESSMENT_ID",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
                "description": "409 if any candidate has attempted it; otherwise deletes it and its questions."
              }
            }
          ]
        },
        {
          "name": "Assessment Questions",
          "item": [
            {
              "name": "Add Question (admin)",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/assessments/REPLACE_ASSESSMENT_ID/questions",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\"questionText\": \"What keyword declares a constant in JS?\", \"type\": \"MCQ\", \"options\": [\"var\", \"let\", \"const\"], \"correctAnswer\": \"const\"}"
                },
                "description": "MCQ: options needs at least two non-empty strings and correctAnswer must match one exactly. Questions are added at the end (position = max + 1)."
              }
            },
            {
              "name": "Add Short Answer Question (admin)",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/assessments/REPLACE_ASSESSMENT_ID/questions",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\"questionText\": \"In one sentence, what is Node.js?\", \"type\": \"Short answer\"}"
                },
                "description": "Short answer / Long answer questions take no options or correctAnswer."
              }
            },
            {
              "name": "Update Question (admin)",
              "request": {
                "method": "PUT",
                "url": "{{baseUrl}}/api/assessments/REPLACE_ASSESSMENT_ID/questions/REPLACE_QUESTION_ID",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\"questionText\": \"Which keyword declares a block-scoped constant?\", \"type\": \"MCQ\", \"options\": [\"var\", \"let\", \"const\"], \"correctAnswer\": \"const\"}"
                },
                "description": "Only the fields sent are changed. Switching to Short/Long answer clears options and correctAnswer."
              }
            },
            {
              "name": "Delete Question (admin)",
              "request": {
                "method": "DELETE",
                "url": "{{baseUrl}}/api/assessments/REPLACE_ASSESSMENT_ID/questions/REPLACE_QUESTION_ID",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
                "description": "409 for the last question of an Active assessment, or a question candidates have already answered."
              }
            }
          ]
        },
        {
          "name": "Assessment Attempts",
          "item": [
            {
              "name": "Submit Attempt (candidate)",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/assessments/REPLACE_ASSESSMENT_ID/attempts",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{candidateToken}}" }] },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\"answers\": [{\"questionId\": \"REPLACE_QUESTION_ID\", \"answer\": \"const\"},{\"questionId\": \"REPLACE_SHORT_ANSWER_QUESTION_ID\", \"answer\": \"It lets you run JavaScript outside the browser.\"}], \"timeTakenSeconds\": 420}"
                },
                "description": "Only MCQ questions are scored; Short/Long answers are saved but not graded. Pass/fail uses the assessment's passingScore."
              }
            },
            {
              "name": "My Attempts (candidate)",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/assessments/attempts/me",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{candidateToken}}" }] }
              }
            },
            {
              "name": "Get Attempt by Id (candidate)",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/assessments/attempts/REPLACE_ATTEMPT_ID",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{candidateToken}}" }] },
                "description": "Only the candidate who made the attempt can read it (403 otherwise)."
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Skill Verification",
      "item": [
        {
          "name": "My Verifications (candidate)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/skill-verifications/me",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{candidateToken}}" }] }
          }
        }
      ]
    },
    {
      "name": "Recruiter",
      "item": [
        {
          "name": "Search Candidates",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/recruiter/candidates",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{recruiterToken}}" }] }
          }
        },
        {
          "name": "Search Candidates by Text",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/recruiter/candidates?q=node",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{recruiterToken}}" }] },
            "description": "q matches candidate name, target career role name, or a Verified skill name (case-insensitive). Only public profiles are returned; match is null without a target role."
          }
        },
        {
          "name": "Search Candidates by Career Role",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/recruiter/candidates?careerRoleId=REPLACE_ROLE_ID",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{recruiterToken}}" }] }
          }
        },
        {
          "name": "Search Candidates by Verified Skill",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/recruiter/candidates?skillId=REPLACE_SKILL_ID",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{recruiterToken}}" }] }
          }
        },
        {
          "name": "Get Candidate Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/recruiter/candidates/REPLACE_USER_ID",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{recruiterToken}}" }] },
            "description": "The id is the candidate's user id (user.id in search results), not the profile id."
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List Users (admin)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/users",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] }
          }
        },
        {
          "name": "Set User Active Status (admin)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/admin/users/REPLACE_USER_ID/status",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"isActive\": false}"
            }
          }
        },
        {
          "name": "Update User (admin)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/admin/users/REPLACE_USER_ID",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Candidate Test\", \"email\": \"candidate@test.com\", \"role\": \"CANDIDATE\"}"
            }
